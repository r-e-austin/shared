# This is the AAP installer inventory file intended for the RPM growth deployment topology.
# Please consult the Ansible Automation Platform product documentation about this topology's tested hardware configuration.
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/tested_deployment_models/rpm-topologies
#
# Please consult the docs if you're unsure what to add
# For all optional variables please consult the Ansible Automation Platform documentation:
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/rpm_installation

# ### This installer inventory contains following modifications:
# ### * External database
# ### * External load-balancer
# ### * Custom CA trust, e.g., an enterprise PKI signer
# ### This inventory file expects to be run from a separate, utility node, i.e., connectivity will be established to nodes via ssh 

# This section is for your AAP Gateway host(s)
# -----------------------------------------------------
[automationgateway]
gateway.example.org

# This section is for your AAP Controller host(s)
# -----------------------------------------------------
[automationcontroller]
controller.example.org

[automationcontroller:vars]
peers=execution_nodes

# This section is for your AAP Execution host(s)
# -----------------------------------------------------
[execution_nodes]
exec.example.org

# This section is for your AAP Automation Hub host(s)
# -----------------------------------------------------
[automationhub]
hub.example.org

# This section is for your AAP EDA Controller host(s)
# -----------------------------------------------------
[automationedacontroller]
eda.example.org

# This section is for the AAP database
# -----------------------------------------------------
[database]
# ### For an external, customer-managed DB, do not include a host here!

[all:vars]

# Common variables
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/rpm_installation/appendix-inventory-files-vars#ref-general-inventory-variables
# -----------------------------------------------------

redis_mode='standalone'

# Load balancer
# ### Set the gateway_main_url variable to the hostname of the Load Balancer used to reverse proxy into the environment
gateway_main_url=https://aap.domain.tld

# Custom CA certs
# ### Concatenate required certs into a single PEM bundle to be trusted by all components.
# ### A common pattern is concatenating one's Enterprise PKI signer or intermediate with AWS's RDS certs
# ### E.g.,
# ### 1. Pull down the AWS global bundle: curl -o ~/aap-installer/certs/aws-rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# ### 2. Concatenate this with any internal CAs you need to trust, e.g., if you have an internal CA that signs the cert for your NLB or other internal resources that you might need AAP to trust: 
# ###    cat ~/aap/certs/aws-rds-global-bundle.pem ~/aap/certs/wawa-internal-ca.pem > ~/aap/certs/aap-custom-trust.pem
# ### 3. Add the custom_ca_cert variable:
custom_ca_cert=/installer/location/aap-installer/certs/aap-custom-trust.pem

# AAP Gateway
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/rpm_installation/appendix-inventory-files-vars#ref-gateway-variables
# -----------------------------------------------------
automationgateway_admin_password=<set your own>
automationgateway_pg_host=db.example.org
# ### If using a custom DB name, set automationgateway_pg_database
#automationgateway_pg_database=<set this if using a custom DB name>
# ### If using a custom user, set automationgateway_pg_username
#automationgateway_pg_username=<set this if using a custom DB user>
automationgateway_pg_password=<set your own>

# AAP Controller
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/rpm_installation/appendix-inventory-files-vars#ref-controller-variables
# -----------------------------------------------------
admin_password=<set your own>
pg_host=db.example.org
# ### If using a custom DB name, set pg_database
#pg_database=<set this if using a custom DB name>
# ### If using a custom DB user, set pg_username
#pg_username=<set this if using a custom DB user>
pg_password=<set your own>

# AAP Automation Hub
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/rpm_installation/appendix-inventory-files-vars#ref-hub-variables
# -----------------------------------------------------
automationhub_admin_password=<set your own>
automationhub_pg_host=db.example.org
# ### If using a custom DB name, set automationhub_pg_database
#automationhub_pg_database=<set this if using a custom DB name>
# ### If using a custom DB user, set automationhub_pg_username
#automationhub_pg_username=<set this if using a custom DB user>
automationhub_pg_password=<set your own>

# AAP EDA Controller
# https://docs.redhat.com/en/documentation/red_hat_ansible_automation_platform/2.6/html/rpm_installation/appendix-inventory-files-vars#event-driven-ansible-controller
# -----------------------------------------------------
automationedacontroller_admin_password=<set your own>
automationedacontroller_pg_host=db.example.org
# ### If using a custom DB name, set automationedacontroller_pg_database
#automationedacontroller_pg_database=<set this if using a custom DB name>
# ### If using a custom DB user, set automationedacontroller_pg_username
#automationedacontroller_pg_username=<set this if using a custom DB user>
automationedacontroller_pg_password=<set your own>
